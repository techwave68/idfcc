// Sample Firestore rules - restrict writes to authenticated users

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read-only to anyone for debugging (change to false in production)
    match /{document=**} {
      allow read: if true;
    }

    // Require authentication for writes
    match /{collection}/{docId} {
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false; // disable deletes via client
    }
  }
}
