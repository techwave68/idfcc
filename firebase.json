{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "admin/**",
      "play store page/**",
      "play store page.zip",
      "README*",
      "FIREBASE_SETUP.md",
      "**/*.md",
      "**/*.txt",
      "**/*.php",
      "key"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
